# Local Wrangler secrets. Copy to .dev.vars (gitignored).
# Keep in sync with .env used by drizzle / bun scripts.

# Postgres database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guilders

# Dashboard, used for redirecting to the dashboard
BACKEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002

# Secret used for provider state verification
GUILDERS_SECRET=

# Better Auth, used for authentication
BETTER_AUTH_SECRET=

# Stripe
STRIPE_PRO_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Email Sending. Optional; defaults to Guilders <noreply@guilders.app>.
# Use an address on a domain onboarded in Email Sending.
# Sending uses the Worker `EMAIL` send_email binding (see wrangler.jsonc), not an API key.
EMAIL_FROM=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# Ngrok, optional, used for callback URLs from open banking providers.
# Leave blank if unused — empty optional URLs are treated as unset.
NGROK_TOKEN=
NGROK_URL=

# Providers, optional, used for open banking providers
## Snaptrade
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=

## SaltEdge
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
