{
  "name": "@guilders/api",
  "module": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:secrets": "wrangler secret bulk .env.production",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "ngrok": "bun --env-file=.env __ngrok-command",
    "auth:generate": "bun --env-file=.env better-auth generate --config better-auth.config.ts --output src/db/schema/auth.ts -y",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun --env-file=.env drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "bun --env-file=.env drizzle-kit studio --config drizzle.config.ts",
    "db:init": "bun --env-file=.env scripts/init-db.ts",
    "db:reset": "docker compose -f ../../docker-compose.yml down -v && docker compose -f ../../docker-compose.yml up -d --wait && bun run db:migrate && bun run db:init",
    "db:query": "bun scripts/db-query.ts",
    "agent:user": "bun --env-file=.env scripts/seed-agent-user.ts",
    "__ngrok-command": "ngrok http 3000 --authtoken=$NGROK_AUTHTOKEN --url=${NGROK_URL}"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.30",
    "@better-auth/api-key": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/expo": "catalog:",
    "@better-auth/infra": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/stripe": "catalog:",
    "@electric-sql/pglite": "^0.3.15",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@guilders/transactional": "workspace:*",
    "@json-render/core": "^0.11.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/components": "1.0.12",
    "@sinclair/typebox": "^0.34.48",
    "agents": "^0.6.0",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "1.0.0-beta.15-859cf75",
    "drizzle-typebox": "^0.3.3",
    "elysia": "1.4.27",
    "fast-json-stable-stringify": "^2.1.0",
    "fflate": "^0.8.2",
    "jose": "^6.1.3",
    "lucide-static": "catalog:",
    "pg": "^8.19.0",
    "react": "catalog:",
    "snaptrade-typescript-sdk": "^9.0.169",
    "stripe": "^20.4.0",
    "workers-ai-provider": "3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "@types/react": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "1.0.0-beta.15-859cf75",
    "vitest": "~3.2.0",
    "vitest-websocket-mock": "^0.5.0",
    "wrangler": "catalog:"
  }
}
