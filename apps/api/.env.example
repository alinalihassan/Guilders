# Single local env file for wrangler dev AND bun CLIs (drizzle, seeds).
# Do not also create .dev.vars — if it exists, Wrangler ignores this file.
# Copy to .env (gitignored). Production secrets go in Cloudflare
# (`wrangler secret bulk .env.production`), not in this file.

# Postgres database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guilders

# Dashboard, used for redirecting to the dashboard
BACKEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002

# Secret used for provider state verification
GUILDERS_SECRET=

# Better Auth, used for authentication
BETTER_AUTH_SECRET=
# Optional. Connects dash() to Better Auth Infrastructure (hosted admin dashboard).
BETTER_AUTH_API_KEY=

# Stripe
STRIPE_PRO_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email is sent via the EMAIL send_email binding in wrangler.jsonc
# (Cloudflare Email Sending). No API key. Local `wrangler dev` simulates
# delivery unless the binding sets `"remote": true`.
# From address: Guilders <noreply@guilders.app>

# Cloudflare. Chat uses the Workers AI binding (`wrangler.jsonc` `ai.binding`)
# plus gateway id `guilders-ai-gateway`. R2 uses the USER_BUCKET binding.
# CLOUDFLARE_ACCOUNT_ID is a GitHub Actions secret, not a Worker env var.
CLOUDFLARE_ACCOUNT_ID=

# Ngrok, optional, used for callback URLs from open banking providers.
# Leave blank if unused — empty optional URLs are treated as unset.
NGROK_TOKEN=
NGROK_URL=

# Providers, optional, used for open banking providers
## Snaptrade
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=

## SaltEdge
SALTEDGE_APP_ID=
SALTEDGE_SECRET=

## EnableBanking
ENABLEBANKING_CLIENT_ID=
ENABLEBANKING_CLIENT_PRIVATE_KEY=

## Teller
TELLER_APPLICATION_ID=
TELLER_PRIVATE_KEY=
TELLER_ENVIRONMENT=
TELLER_WEBHOOK_SECRET=
