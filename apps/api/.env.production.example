# Local reference for production values. Used by `bun run db:migrate:prod`.
# Do not upload this file with `wrangler secret bulk` — that deploys the current
# working tree. Put Worker secrets with `wrangler secret put NAME` one at a time.
# Prefer the Neon direct URL here (not the pooler) so drizzle-kit can DDL.
# R2 and Workers AI are bindings, not secrets.

DATABASE_URL=
BACKEND_URL=https://guilders.app
DASHBOARD_URL=https://dashboard.guilders.app

GUILDERS_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=

STRIPE_PRO_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRO_FEATURES_FREE_FOR_ALL=

TELLER_APPLICATION_ID=
TELLER_PRIVATE_KEY=
TELLER_ENVIRONMENT=
TELLER_WEBHOOK_SECRET=

# Unused by the Worker. Users paste Lunch Flow keys in Settings → Connections.
LUNCHFLOW_API_KEY=
