# Template for `wrangler secret bulk .env.production`.
# Copy to .env.production (gitignored) and fill production values.
# That file is only an upload source — the Worker reads Cloudflare secrets.
# DATABASE_URL must be the Neon pooled URL. GitHub migrate uses the direct URL.
# R2 and Workers AI are bindings, not secrets.

DATABASE_URL=
BACKEND_URL=https://api.guilders.app
DASHBOARD_URL=https://dashboard.guilders.app

GUILDERS_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=

STRIPE_PRO_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
